NULL=
PROGFILES =  \
$(wildcard  ../app/*.f90)                       $(wildcard  ../app/*.F90)                       \
$(wildcard  ../example/DEMOS/*.f90)             $(wildcard  ../example/DEMOS/*.F90)             \
$(wildcard  ../example/CALCOMP_EXAMPLES/*.f90)  $(wildcard  ../example/CALCOMP_EXAMPLES/*.F90)  \
$(wildcard  ../example/M_DRAW_EXAMPLES/*.f90)   $(wildcard  ../example/M_DRAW_EXAMPLES/*.F90)   \
$(wildcard  ../example/NCURSES_EXAMPLES/*.f90)  $(wildcard  ../example/NCURSES_EXAMPLES/*.F90)  \
$NULL

TESTFILES = $(wildcard ../test/*.f90) $(wildcard ../test/*.F90)
TPROG1 = ${TESTFILES:.f90=}
TPROG  = ${TPROG1:.F90=}

CPROGFILES =

PROG1  = ${PROGFILES:.f90=}
PROG   = ${PROG1:.F90=}

CPROG = ${CPROGFILES:.c=}

SRCS =  $(wildcard  ../src/*.f90) $(wildcard  ../src/*.F90)

OBJS := $(SRC_FILES:.f90=.o)
OBJS := $(OBJ_FILES:.F90=.o)

# # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # #
# platform-specific values you will probably change
#
LIBS := $(shell bash ../scripts/if_library_found ncurses curl tinfo sqlite3 readline X11)
CC := cc
CFLAGS := -O
F90:= gfortran
FFLAGS := -fcoarray=single
LDFLAGS :=-fcoarray=single
F90FLAGS := -fcoarray=single
#
# You can either ignore it, or disable the "may be used uninitialized"
# warnings with -Wno-maybe-uninitialized or compile with optimizations
# (-O1 and more).
gfortran: F90=gfortran
gfortran: F90FLAGS := -g -O -Wall -std=f2018 -Wextra -Wno-maybe-uninitialized -Wno-uninitialized -finit-local-zero -fcoarray=single
gfortran: all
	@echo built with $(F90)

nvfortran: F90=nvfortran
nvfortran: F90FLAGS := -Minform=inform -Mbackslash -traceback
nvfortran: all
	@echo built with $(F90)

flang: F90=flang
flang: F90FLAGS := 
flang: all
	@echo built with $(F90)

ifx: F90=ifx
ifx: F90FLAGS := -warn all -traceback
ifx: all
	@echo built with $(F90)

ifort: F90=ifort
ifort: F90FLAGS := -warn all -traceback
ifort: all
	@echo built with $(F90)

nagfor: F90=nagfor
nagfor: F90FLAGS := -C all
nagfor: all
	@echo built with $(F90)

# # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # #
all: show $(PROG) $(CPROG) $(TPROG)
	@echo "That's all folks!"

$(PROG): $(OBJS)

	-$(F90) $(F90FLAGS) $(LDFLAGS) $@.[fF]90 -o $@ $(OBJS) $(LIBS) # && ./$@ </dev/null

$(TPROG): $(OBJS)

	-$(F90) $(LDFLAGS) $@.[fF]90 -o $@ $(OBJS) $(LIBS) # && ./$@ </dev/null

.PHONY: clean
clean:
	rm -fv $(PROG) $(CPROG) $(OBJS) *.smod *.mod $(TPROG)

.PHONY: help
help:
	- # make [compiler]   -- build M_unicode module                         
	- # run  [compiler]   -- run manpage demo programs and test program     
	- # test [compiler]   -- run test program (requires additional modules) 
	- # man               -- show all manpages as text                      
	- # ship              -- rebuild archive files of manpages              
	- # clean             -- clean directory of object files and executables
	- # doxygen           -- run doxygen(1) if you have it                  
	- # help              -- display this text                              
	- #                                                                    
	- #   where compiler is  gfortran|ifx|nvfortran|ifort|nagfor, and you
	- #   must build with "make [COMPILER]" before "make run|test [COMPILER]"

.PHONY: ship
ship:
	: make easily distributed archive files of manpages
	mkdir -p ../docs; \
	 cd ../man/;    gzip */*.?m_unicode; \
	 gzip -r ../docs/manpages.zip   */*m_unicode*.gz; \
	 tar cvfz ../docs/manpages.tgz */*m_unicode*.gz; \
	 gunzip */*.?m_unicode.gz

.PHONY: show
show:
	: "CC        $(CC)"
	: "CFLAGS    $(CLAGS)"
	: "FC        $(FC)"
	: "FFLAGS    $(FFLAGS)"
	: "F90       $(F90)"
	: "F90FLAGS  $(F90FLAGS)"
	: "LDFLAGS   $(LDLAGS)"
	: "LIBS      $(LIBS)"

.PHONY: run
run: $(PROG)
	# run everything
	echo $? | xargs -n 1
#	echo $? | xargs -n 1  |xargs -iXX /bin/time XX  \</dev/null
	echo $? | xargs -n 1  |(set +x;xargs -iXX env XX 2>&1)

.PHONY: test
test: $(TPROG)
	# run everything
	echo $? | xargs -n 1
	echo $? | xargs -n 1  |(set +x;xargs -iXX env XX 2>&1)

.PHONY: doxygen
doxygen:
	doxygen dox.in

.PHONY: man
man:
	@mandb ../man 1>&2
	@env MANPATH=../man MANWIDTH=256 man -k .|col -b
	@env MANPATH=../man MANWIDTH=80  man --encoding=UTF-8 --troff-device=utf8 --regex '.*'|col -b

.SUFFIXES: $(SUFFIXES) .f90 .F90

.f90.o:
	$(F90) $(F90FLAGS) -c $<

.F90.o:
	$(F90) $(F90FLAGS) -c $<

